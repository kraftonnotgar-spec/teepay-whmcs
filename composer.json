{
    "name": "teepay/teepay-whmcs",
    "description": "TeePay mobile money payment gateway module for WHMCS (M-Pesa, Airtel Money, Mixx by Yas, HaloPesa).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "TeePay\\Whmcs\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform-check": false
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find modules tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
